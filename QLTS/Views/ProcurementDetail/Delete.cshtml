@model QLTS.Models.ProcurementDetail

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>ProcurementDetail</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Procurement)
        </dt>
        <dd class="col-sm-10">
            @(Model?.Procurement?.ProcurementCode) - @(Model?.Procurement?.RequesterName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Asset)
        </dt>
        <dd class="col-sm-10">
            @(Model?.Asset?.AssetCode) - @(Model?.Asset?.AssetName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.UnitCost)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.UnitCost)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ProcurementDetailId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
