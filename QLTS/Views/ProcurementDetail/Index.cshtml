@model IEnumerable<QLTS.Models.ProcurementDetail>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Procurement)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Asset)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UnitCost)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @(item.Procurement?.ProcurementCode) - @(item.Procurement?.RequesterName)
                </td>
                <td>
                    @(item.Asset?.AssetCode) - @(item.Asset?.AssetName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UnitCost)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.ProcurementDetailId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.ProcurementDetailId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.ProcurementDetailId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
