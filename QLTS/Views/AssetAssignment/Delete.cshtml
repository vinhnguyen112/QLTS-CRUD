@model QLTS.Models.AssetAssignment

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <h4>AssetAssignment</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Asset)
        </dt>
        <dd class="col-sm-10">
            @(Model?.Asset?.AssetCode) - @(Model?.Asset?.AssetName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FromDepartment)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FromDepartment!.DepartmentName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ToDepartment)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ToDepartment!.DepartmentName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.FromEmployee)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FromEmployee!.FullName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ToEmployee)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ToEmployee!.FullName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AssignmentDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AssignmentDate)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Reason)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Reason)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Creator)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Creator!.FullName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CreatedAt)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CreatedAt)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="AssignmentId" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
