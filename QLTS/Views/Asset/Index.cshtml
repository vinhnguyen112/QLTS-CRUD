@model IEnumerable<QLTS.Models.Asset>

@{
    ViewData["Title"] = "Danh sách tài sản";
}

<h1>Danh sách tài sản</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Tạo mới</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.AssetCode)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.AssetName)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Category)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Department)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Employee)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.SerialNumber)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.OriginalCost)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.PurchaseDate)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Location)
            </th>

            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>

            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.AssetCode)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.AssetName)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Category.CategoryName)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Department.DepartmentName)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Employee.FullName)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.SerialNumber)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.OriginalCost)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.PurchaseDate)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Location)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Status)
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.AssetId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.AssetId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.AssetId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>